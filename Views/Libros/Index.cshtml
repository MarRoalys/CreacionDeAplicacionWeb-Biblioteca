@model IEnumerable<Practica02BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Catálogo de Libros</h1>
        <p class="text-muted mb-0">Listado general de ejemplares en la Biblioteca del Norte.</p>
    </div>
    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
    {
        <a asp-action="Create" class="btn btn-success">Nuevo Libro</a>
    }
</div>

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>ISBN</th>
                <th>Título</th>
                <th>Categoría</th>
                <th>Autor</th>
                <th>Stock</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="badge bg-secondary">@item.Isbn</span></td>
                    <td class="fw-bold">@item.Titulo</td>
                    <td>@item.CategoriaNombre</td>
                    <td>@item.AutorNombreCompleto</td>
                    <td>@item.Stock</td>
                    <td>
                        @if(item.Estado == 1) { <span class="badge bg-success">Disponible</span> }
                        else { <span class="badge bg-danger">Agotado / Inactivo</span> }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.IdLibro" class="btn btn-sm btn-outline-info">Ver</a>
                        
                        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.IdLibro" class="btn btn-sm btn-outline-primary">Editar</a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.IdLibro" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>