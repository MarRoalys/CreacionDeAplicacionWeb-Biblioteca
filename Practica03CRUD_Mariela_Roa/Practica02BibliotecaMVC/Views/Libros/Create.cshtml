@model Practica02BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Registrar Nuevo Libro";
}

<h1>Registrar Nuevo Libro</h1>
<hr />

<div class="card shadow-sm max-w-lg">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="col-md-4">
                <label asp-for="Isbn" class="form-label fw-bold"></label>
                <input asp-for="Isbn" class="form-control" placeholder="Ej: 978-3-16-148410-0" />
                <span asp-validation-for="Isbn" class="text-danger small"></span>
            </div>
            
            <div class="col-md-8">
                <label asp-for="Titulo" class="form-label fw-bold"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Título completo del libro" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>
            
            <div class="col-md-4">
                <label asp-for="IdCategoria" class="form-label fw-bold"></label>
                <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select">
                    <option value="">Seleccione categoría...</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger small"></span>
            </div>
            
            <div class="col-md-4">
                <label asp-for="IdAutor" class="form-label fw-bold"></label>
                <select asp-for="IdAutor" asp-items="ViewBag.Autores" class="form-select">
                    <option value="">Seleccione autor...</option>
                </select>
                <span asp-validation-for="IdAutor" class="text-danger small"></span>
            </div>
            
            <div class="col-md-4">
                <label asp-for="IdEditorial" class="form-label fw-bold"></label>
                <select asp-for="IdEditorial" asp-items="ViewBag.Editoriales" class="form-select">
                    <option value="">Seleccione editorial...</option>
                </select>
                <span asp-validation-for="IdEditorial" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="AnioPublicacion" class="form-label fw-bold"></label>
                <input asp-for="AnioPublicacion" class="form-control" type="number" placeholder="Ej: 2023" />
                <span asp-validation-for="AnioPublicacion" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Stock" class="form-label fw-bold"></label>
                <input asp-for="Stock" class="form-control" type="number" min="0" />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Estado" class="form-label fw-bold"></label>
                <select asp-for="Estado" class="form-select">
                    <option value="1">Disponible / Activo</option>
                    <option value="0">Agotado / Inactivo</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>
            
            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-success">Guardar Libro</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}